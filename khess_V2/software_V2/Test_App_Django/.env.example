CLE_SECRETE=

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# CAS remains disabled until ENSEA IT supplies and approves these values.
CAS_ENABLED=False
CAS_SERVER_URL=
CAS_CALLBACK_URL=
# This integration supports CAS 3 only. Set to 3 after IT confirms support.
CAS_PROTOCOL_VERSION=
# Attribute containing an immutable, non-reassigned identifier; or __principal__
# ONLY if IT confirms the CAS principal itself has those guarantees.
CAS_ID_ATTRIBUTE=
CAS_ELIGIBILITY_ATTRIBUTE=
# Comma-separated exact values allowed to sign in (including staff if approved).
CAS_ELIGIBLE_VALUES=
# One exact value identifying students allowed to receive a new wallet.
CAS_STUDENT_VALUE=
CAS_AUTO_CREATE_STUDENTS=False
# Enable only after every existing account is mapped or explicitly resolved.
CAS_EXISTING_ACCOUNTS_RECONCILED=False
